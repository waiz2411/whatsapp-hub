# Your Main WhatsApp Number to receive alerts
# Format: Country code + Number without spaces, '+', or dashes
# Example: 14155552671 (for US +1 415 555 2671) or 919876543210 (for India +91 9876543210)
MAIN_PHONE_NUMBER=1234567890

# Total number of business accounts to manage (default 4)
ACCOUNTS_COUNT=4

# Dashboard port
PORT=3000

# Seconds to group rapid consecutive messages from the same contact into one alert
DEBOUNCE_SECONDS=15

# Notification Style: 'detailed' (includes message preview & wa.me reply link) or 'minimal'
NOTIFICATION_STYLE=detailed
